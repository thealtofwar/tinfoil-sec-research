+// strictTopLevel requires body to be a JSON object whose member names are exactly
+// want (case-sensitive), each appearing once. (fix check for the case-fold differential)
+func strictTopLevel(body []byte, want ...string) error {
+	dec := json.NewDecoder(bytes.NewReader(body))
+	if t, err := dec.Token(); err != nil || t != json.Delim('{') {
+		return fmt.Errorf("PCS response is not a JSON object")
+	}
+	seen := map[string]bool{}
+	for dec.More() {
+		t, err := dec.Token()
+		if err != nil {
+			return err
+		}
+		k := t.(string)
+		ok := false
+		for _, w := range want {
+			ok = ok || k == w
+		}
+		if !ok || seen[k] {
+			return fmt.Errorf("unexpected or duplicate member %q in PCS response", k)
+		}
+		seen[k] = true
+		var skip json.RawMessage
+		if err := dec.Decode(&skip); err != nil {
+			return err
+		}
+	}
+	if len(seen) != len(want) {
+		return fmt.Errorf("PCS response members %v, want %v", seen, want)
+	}
+	return nil
+}
